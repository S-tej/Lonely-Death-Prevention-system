{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "alerts": {
      "$userId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["timestamp", "acknowledged"]
      }
    },
    "vitals": {
      "$userId": {
        ".indexOn": ["timestamp", "type"],
        ".read": true,
        ".write": true
      }
    },
    "ecg_data": {
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    },
    "profiles": {
      ".read": true,
      ".write": true
    },
    "users": {
      ".read": true,
      ".write": true
    },
    "passwordResets": {
      ".read": true,
      ".write": true,
      ".indexOn": ["expiration"]
    }
  }
}
